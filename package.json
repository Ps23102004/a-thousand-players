{
  "name": "a-thousand-players",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A crowd of Nemotron-driven players that plays, breaks and fixes your browser game.",
  "scripts": {
    "predev": "node scripts/sync-game.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-game.mjs",
    "build": "next build",
    "engine:test": "node engine/test-engine.mjs 16",
    "crowd": "node engine/crowd.mjs",
    "blackbox": "node blackbox/cli.mjs",
    "start": "next start",
    "test:engine": "node --test \"engine/tests/*.test.mjs\" \"blackbox/*.test.mjs\"",
    "test:ts": "tsx --test lib/*.test.ts ai/*.test.ts app/api/*.test.ts",
    "test": "npm run test:engine && npm run test:ts",
    "test:cov": "node --experimental-test-coverage --test-coverage-exclude=\"**/*.test.*\" --test-coverage-exclude=\"engine/tests/**\" --test-coverage-exclude=\"node_modules/**\" --test \"engine/tests/*.test.mjs\" && tsx --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.*\" --test-coverage-exclude=\"engine/tests/**\" --test-coverage-exclude=\"node_modules/**\" lib/*.test.ts ai/*.test.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.15"
  }
}
